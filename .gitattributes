# Keep Godot text resources stable across Windows and Unix environments.
* text=auto eol=lf

# Godot scenes and resources are text unless explicitly stored as binary.
*.gd text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.md text eol=lf

# Binary assets must not be line-ending normalized.
*.blend binary
*.glb binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
