# Godot 4 generated cache
.godot/
*.translation
*.import

# Legacy Godot generated files
/.import/
export.cfg

# Export credentials are machine-local and may contain secrets.
export_credentials.cfg

# Godot 4.2+ temporary native libraries
~*.dll
.nomedia

# C# / Mono generated files (kept for future compatibility)
.mono/
data_*/
mono_crash.*.json

# Exported builds
/builds/
/exports/
*.pck
*.zip

# Imported source assets and Blender backups
*.blend1
*.blend2

# Python caches generated by Blender helper scripts
__pycache__/
*.py[cod]

# IDE / OS
.vscode/
.idea/
.vs/
*.sln
*.csproj
*.user
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*~
*.dmp
crash_*.txt
.codex-captures/
/tmp/

# Local environment overrides and credentials
.env
.env.*
!.env.example
