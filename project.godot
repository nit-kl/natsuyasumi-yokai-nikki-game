; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="夏休み妖怪日記"
config/description="田舎の町で過ごす、ひと夏の妖怪日記。"
run/main_scene="res://scenes/bootstrap/title.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameState="*res://scripts/core/game_state.gd"
GameClock="*res://scripts/core/game_clock.gd"
DialogueManager="*res://scripts/core/dialogue_manager.gd"
BugCatchingManager="*res://scripts/minigames/bug_catching_manager.gd"
EventManager="*res://scripts/events/event_manager.gd"
DayRecordManager="*res://scripts/diary/day_record_manager.gd"
DayFlowManager="*res://scripts/core/day_flow_manager.gd"
DiaryManager="*res://scripts/diary/diary_manager.gd"
SaveManager="*res://scripts/save/save_manager.gd"
SceneFlow="*res://scripts/core/scene_flow.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

