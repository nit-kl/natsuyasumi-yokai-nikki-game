; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="夏休み妖怪日記"
run/main_scene="res://scenes/bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

GameState="*res://scripts/core/game_state.gd"
GameClock="*res://scripts/core/game_clock.gd"
CalendarManager="*res://scripts/core/calendar_manager.gd"
SaveManager="*res://scripts/save/save_manager.gd"
SceneTransitionManager="*res://scripts/core/scene_transition_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]

textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.447, 0.655, 0.553, 1)

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="World"
2d_physics/layer_3="Interaction"
2d_physics/layer_4="NPC"
2d_physics/layer_5="Yokai"
2d_physics/layer_6="Insects"
2d_physics/layer_7="EventTriggers"
2d_physics/layer_8="Water"

[input]

move_up={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"keycode":4194320), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
move_down={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"keycode":4194322), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
move_left={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"keycode":4194319), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"keycode":4194321), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventKey,"physical_keycode":90), Object(InputEventJoypadButton,"button_index":0)]
}
run={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadButton,"button_index":2)]
}
use_tool={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":88), Object(InputEventJoypadButton,"button_index":1)]
}
open_diary={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":74), Object(InputEventJoypadButton,"button_index":3)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":6)]
}
debug_menu={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}
