[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="World"
2d_physics/layer_3="Interaction"
2d_physics/layer_4="NPC"
2d_physics/layer_5="Yokai"
2d_physics/layer_6="Insects"
2d_physics/layer_7="EventTriggers"
2d_physics/layer_8="Water"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.447, 0.655, 0.553, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
