[gd_resource type="Resource" script_class="DialogueSequence" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_line.gd" id="2_line"]
[ext_resource type="Texture2D" path="res://assets/ui/portraits/grandma.png" id="3_grandma_portrait"]
[ext_resource type="Texture2D" path="res://assets/ui/portraits/protagonist.png" id="4_protagonist_portrait"]

[sub_resource type="Resource" id="DialogueLine_1"]
script = ExtResource("2_line")
speaker = "おばあちゃん"
text = "おはよう。よく眠れたかい？"
portrait = ExtResource("3_grandma_portrait")

[sub_resource type="Resource" id="DialogueLine_2"]
script = ExtResource("2_line")
speaker = "おばあちゃん"
text = "川へ行くなら、日が高いうちにお帰り。昨日の雨で水が増えているからね。"
portrait = ExtResource("3_grandma_portrait")

[sub_resource type="Resource" id="DialogueLine_3"]
script = ExtResource("2_line")
speaker = "ぼく"
text = "うん。ちょっと見てくるだけ。"
portrait = ExtResource("4_protagonist_portrait")

[resource]
script = ExtResource("1_sequence")
dialogue_id = &"grandma_morning"
lines = Array[ExtResource("2_line")]([SubResource("DialogueLine_1"), SubResource("DialogueLine_2"), SubResource("DialogueLine_3")])
