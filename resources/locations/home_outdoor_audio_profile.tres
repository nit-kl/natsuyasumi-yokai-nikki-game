[gd_resource type="Resource" script_class="EnvironmentAudioProfile" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/audio/environment_audio_profile.gd" id="1_profile"]
[ext_resource type="AudioStream" path="res://assets/audio/ambience/amb_home_outdoor_daytime.ogg" id="2_daytime"]
[ext_resource type="AudioStream" path="res://assets/audio/ambience/amb_home_outdoor_evening.ogg" id="3_evening"]
[ext_resource type="AudioStream" path="res://assets/audio/ambience/amb_outdoor_rain.ogg" id="4_rain"]
[ext_resource type="AudioStream" path="res://assets/audio/ambience/amb_outdoor_thunderstorm.ogg" id="5_storm"]

[resource]
script = ExtResource("1_profile")
area_id = &"home_outdoor"
daytime_stream = ExtResource("2_daytime")
evening_stream = ExtResource("3_evening")
apply_weather_streams = true
rain_stream = ExtResource("4_rain")
thunderstorm_stream = ExtResource("5_storm")
volume_db = -10.0
